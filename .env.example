# AgentGate 本地部署坐标（模板）。
#
# 这里全是**占位符**。真值属于某一个具体 AWS 账号，不进版本库 ——
# 拷一份成 `.env.local`（已被 .gitignore 忽略）填自己的值，用之前先 export：
#
#   cp .env.example .env.local
#   $EDITOR .env.local
#   set -a; . ./.env.local; set +a      # 每个新 shell 跑一次
#
# 每一项都给了「现算」命令：**能现算的一律现算**，转抄值会过期
# （runbook 里栽过：把 LastModified 当成部署时间、把旧 ETag 当成当前字节）。
# 所有现算命令都是只读的（describe-*），不改任何资源。

# ---------- 区域（非敏感，真值就写在这儿） ----------
AWS_REGION=us-west-2

# ---------- 栈名（非敏感：逻辑名就定义在 infra/app.py 里） ----------
EVAL_RUNTIME_STACK=EvalAnythingRuntime
EVAL_UI_STACK=EvalAnythingUi

# ---------- 评估 Runtime（scripts/*_probe.py 用） ----------
# 留空则脚本自己去栈里现算（推荐）：
#   aws cloudformation describe-stacks --stack-name EvalAnythingRuntime \
#     --query "Stacks[0].Outputs[?OutputKey=='RuntimeArn'].OutputValue" --output text
EVAL_RUNTIME_ARN=

# ---------- 目录表（scripts/cache_probe.py 直读 DynamoDB 用） ----------
# 现算（物理名带 CFN 随机后缀，不可能猜）。
# ⚠️ 别用 `describe-stack-resource --logical-resource-id CatalogTable`：**CDK 会给资源
# 逻辑 id 加 hash 后缀**（`CatalogTable` → `CatalogTable<HASH>`），裸名一律 ValidationError。
# hash 也不许写死（重构栈就变）。所以按「类型 + 逻辑 id 前缀」列举，**要求恰好一条**：
#   aws cloudformation list-stack-resources --stack-name EvalAnythingRuntime \
#     --query "StackResourceSummaries[?ResourceType=='AWS::DynamoDB::Table' \
#              && starts_with(LogicalResourceId,'CatalogTable')].PhysicalResourceId" \
#     --output text
# 前缀和类型两半都不能省：一个栈里同类资源经常有多个（实测 2026-08-26：EvalAnythingUi
# 有 3 个 Lambda、3 个 IAM Role、2 个 IAM Policy），只按类型过滤会多命中，而同类多命中
# 时静默取第一个会给出「格式正确的错值」。上面这两个资源目前恰好各自是本栈里同类唯一，
# 但靠这一点就等着有人加第二个桶的那天出事 ⇒ 前缀照写。
CATALOG_TABLE=<CatalogTable-physical-name>

# ---------- 被探测的目标 Agent（探针脚本的被测对象，按环境不同） ----------
# 日志组现算：
#   aws logs describe-log-groups \
#     --log-group-name-prefix /aws/bedrock-agentcore/runtimes/ \
#     --query 'logGroups[].logGroupName' --output text
PROBE_TARGET_AGENT=<target-agent-name>
PROBE_TARGET_LOG_GROUP=/aws/bedrock-agentcore/runtimes/<target-runtime-id>-DEFAULT

# ---------- 站点边缘（web/scripts/verify-edge.sh 与发布 runbook 用） ----------
# 现算（三条都只读）。第一条走 Output（**key 没有 hash 后缀**，裸名就对）；
# 后两条是**资源**，同上必须按「类型 + 前缀」列举，不能用 describe-stack-resource：
#   aws cloudformation describe-stacks --stack-name EvalAnythingUi \
#     --query "Stacks[0].Outputs[?OutputKey=='SiteUrl'].OutputValue" --output text
#   aws cloudformation list-stack-resources --stack-name EvalAnythingUi \
#     --query "StackResourceSummaries[?ResourceType=='AWS::CloudFront::Distribution' \
#              && starts_with(LogicalResourceId,'Distribution')].PhysicalResourceId" \
#     --output text
#   aws cloudformation list-stack-resources --stack-name EvalAnythingUi \
#     --query "StackResourceSummaries[?ResourceType=='AWS::S3::Bucket' \
#              && starts_with(LogicalResourceId,'SiteBucket')].PhysicalResourceId" \
#     --output text
VE_EDGE_BASE=https://<distribution-domain>.cloudfront.net
CF_DISTRIBUTION_ID=<E...distribution-id>
SITE_BUCKET=<site-bucket-physical-name>

# ---------- 登录（Cognito；口令从来不落盘，任何地方都别写） ----------
# 现算：
#   aws cloudformation describe-stacks --stack-name EvalAnythingUi \
#     --query "Stacks[0].Outputs[?OutputKey=='UserPoolIdOut'].OutputValue" --output text
COGNITO_USER_POOL_ID=<region>_<pool-suffix>
COGNITO_LOGIN_USER=<login-username>
